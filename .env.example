# Copy to .env and edit. Read by docker compose.

# Host directory holding the database. It must exist, be owned by
# KORECAL_UID:KORECAL_GID and be initialized once with `korecalendar init`
# (see README).
KORECAL_DATA_DIR=/srv/korecalendar

# Where Caddy is published on the host. 127.0.0.1 = this machine only (e.g. for
# cloudflared running on the host); 0.0.0.0 = LAN / Tailscale too.
KORECAL_BIND=127.0.0.1
KORECAL_PORT=8080

# User and group the API runs as; files in KORECAL_DATA_DIR are owned by them.
KORECAL_UID=1000
KORECAL_GID=1000

# Image tag to run for both the api and the web image: pin a release such as 0.1.0
# (docs/releasing.md); latest follows the newest stable release, edge follows main.
KORECAL_VERSION=latest

# The public https address of this calendar. Required for Kore ID (it builds the
# redirect URI) and sent to push services as the operator contact for browser
# notifications.
KORECAL_PUBLIC_URL=

# Subnet of the Docker network Caddy publishes on. Connections from this host
# arrive from its gateway and are the only ones whose X-Forwarded-* and
# CF-Connecting-IP headers are trusted (e.g. cloudflared on the host). Change it
# only if it collides with an existing network.
KORECAL_SUBNET=172.31.255.0/24

# --- Sign in with Kore ID (required to sign in) --------------------------------
# Kore ID is the only way in: there is no email + password login and no first-run
# form. Without an issuer the apps start but say no sign-in method is configured.
# The redirect URI to register with Kore ID is  <KORECAL_PUBLIC_URL>/api/auth/oidc/callback
# the post-logout redirect URI is  <KORECAL_PUBLIC_URL>/login  and the back-channel
# logout URI (backchannelLogoutUri) is  <KORECAL_PUBLIC_URL>/api/auth/oidc/backchannel-logout .
# Who may use KoreCalendar is decided in Kore ID (app access "korecalendar"). See docs/deploy.md.
KORECAL_OIDC_ISSUER=
# Defaults to korecalendar.
KORECAL_OIDC_CLIENT_ID=
# The client secret Kore ID printed for this client. Keep this file private (chmod 600).
KORECAL_OIDC_CLIENT_SECRET=
# Extra client ids whose access tokens the API accepts as bearer tokens, comma separated
# (the Android app's public client, e.g. korecalendar-android).
KORECAL_OIDC_EXTRA_AUDIENCES=
# Kore ID subjects (UUIDs) that are administrators here, comma separated. An alternative
# on a fresh install is KORECAL_OIDC_OWNER_EMAIL below. (Access itself is granted in Kore ID.)
KORECAL_OIDC_ADMIN_SUBS=
# On a fresh install the first Kore ID sign-in whose verified email equals this address
# becomes the administrator. Lowercased; must be an email address. Set this before the
# first start when KoreCalendar starts with Kore ID alone.
KORECAL_OIDC_OWNER_EMAIL=
# Create a local account on first Kore ID sign-in: true (default) or false.
KORECAL_OIDC_AUTO_PROVISION=
# Link a Kore ID login to an existing local account with the same email: verified
# (default: when Kore ID says email_verified, which it does for its admin-managed
# accounts), off (never; use the link command) or trusted. See docs/deploy.md.
KORECAL_OIDC_LINK_BY_EMAIL=
# Button label (default "Kore ID") and scopes (default "openid profile email").
KORECAL_OIDC_NAME=
KORECAL_OIDC_SCOPES=
# The other Kore apps for the app switcher in the account menu, comma separated
# app=URL (apps: kore, koremind, korecalendar, flatline). korecalendar defaults to
# KORECAL_PUBLIC_URL. Example: kore=https://kore.example,koremind=https://mind.example
KORECAL_KORE_APPS=
